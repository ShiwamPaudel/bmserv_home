{
  "name": "@bmserv/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --import tsx src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --packages=external --tsconfig=tsconfig.json --outfile=dist/index.js && node -e \"require('fs').cpSync('src/db/migrations','dist/migrations',{recursive:true})\"",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "services:check": "tsx src/scripts/check-services.ts",
    "r2:cors": "tsx src/scripts/r2-cors.ts",
    "vercel:output": "tsx src/scripts/vercel-output.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1168.0",
    "@aws-sdk/s3-request-presigner": "^3.1168.0",
    "@bmserv/shared": "*",
    "@hono/node-server": "^2.1.8",
    "@libsql/client": "^0.18.0",
    "better-auth": "^1.7.22",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.18",
    "nanoid": "^6.0.2",
    "node-cron": "^4.6.0",
    "resend": "^6.38.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15"
  }
}
